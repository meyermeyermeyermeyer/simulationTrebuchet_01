% Descrition : Les figures de Chladni sont une représentation visuelle des 
% modes de vibration naturels d'une plaque sous différentes excitations.
% Si la fréquence se trouve à une fréquence naturelle, les amplitudes 
% de mouvement seront plus élevées et des noeuds seront créés. 
% Ce script peremt de détemriner les première fréquences naturelles et les 
% figures qu'elles créent.


%% Initialisation 
clc, clear , close all hidden

%% Données

L = 0.1;      % Longueur d'un côté de le membrane carré [m]
T = 200;      % Tension linéique de la membrane [N/m]
rho = 0.296;  % Masse surfacique de la membrane [kg/m^2]
P = 6;        % Nombre de figures ou des plus petites fréquences
N = 100;      % Nombre de points par ligne


%% Algorithme 

% Données dépendantes

c = sqrt(T/rho); % Vitesse de propagation des ondes dans la membrane[m/s^2]
h = L/(N+1);     % Pas 
dof = N^2;

%% Étape A i. L'équation d'onde 2D

% Réécriture de l'équation d'onde avec comme solution u(x,y,t) =
% u(x,y)*sin(wt), représentant la hauteur du déplacement de la membrane 
% en un point (x, y), mesurée à partir de sa position au repos

% ici le d représente la dérivée partielle

% u(x,y,t) = u(x,y)*sin(w*t);
% du(x,y,z)/dt = u(x,y)*w*cos(w*t)
% d2u(x,y,z)/dt2 = - w^2*u(x,y)*sin(w*t) (1)

% L'équation d'onde est d2u(x,y,t)/dt2 = c^2(d2u(x,y,t)/dx2+d2u(x,y,t)/dy2)
% On remplace par u(x,y,t) = u(x,y)*sin(w*t);
% d2u(x,y,t)/dt2 = c^2(d2u(x,y)/dx2*sin(w*t)+d2u(x,y)/dy2*sin(w*t))
% d2u(x,y,t)/dt2 = c^2(d2u(x,y)/dx2+d2u(x,y)/dy2)*sin(w*t) (2)

% (1) = (2)
% - w^2*u(x,y)*sin(w*t) = c^2(d2u(x,y)/dx2+d2u(x,y)/dy2)*sin(w*t)
% Nous obtenons : - w^2*u(x,y) = c^2(d2u(x,y)/dx2+d2u(x,y)/dy2)

% La condition limite au déplacement : 
% déplacements transverses sur les 4 bords sont nuls, 
% soit u = 0 pour les quatres bords de la membrane, 
% donc quand i = 1 ou N et quand j = 1 ou N. 


%% Étape A ii.

% La méthode de différence sera seulement évalué avec la dérivation
% numérique centré, car au bords de la membrane on sait déjà que u = 0. 

% Ainsi, en x nous avons : 
% (u_{i+1,j} -2*u_{i,j} + u_{i-1,j})/h^2

% En y nous avons : 

%(u_{i,j+1} -2*u_{i,j} + u_{i,j-1})/h^2

% On peu combiné les termes en x et y qui correspond dans l'équation d'onde
% à (d2u(x,y,t)/dx2 + d2u(x,y,t)/dy2).

%(u_{i+1,j} + u_{i-1,j} + u_{i,j+1} + u_{i,j-1} -4*u_{i,j})/h^2

% On obtient donc comme équation d'onde 2D : 

% -w^2 u(x,y) = c^2*((u_{i+1,j} + u_{i-1,j} + u_{i,j+1} + u_{i,j-1} -4*u_{i,j})/h^2)

% Les conditions limites dans cette forme s'écrivent comme,
% u_{1,1} = 0 ; u_{N,1} = 0 ; u_{1,N} = 0 ; u_{N,N} = 0.


%% Étape A iii.

% Pour ce déplacer dans la plaque 2D avec un array 1D, noous utilisons
% comme incrémentation k = (i-1)*N + j où i sont les lignes et j les
% colonnes. 


K = spalloc(dof,dof,5*dof);
M = speye(dof);

coeff = 1/h^2;

for i = 1:N
    for j = 1:N

        k = (i-1)*N + j;

        K(k,k) = -4*coeff; % Création de la diagonale de nombre 4

        if i > 1
            K(k-N,k) = coeff; % Création du voisin supérieur
        end

        if i < N
            K(k+N,k) = coeff; % Création du voisin inférieur
        end

        if j > 1
            K(k-1,k) = coeff; % Création du voisinde de gauche
        end

        if j < N
            K(k+1,k) = coeff; % Création du voisin de droite
        end
    end
end

%% Étape B iv.

% Il faut résoudre l'équation [K]*{u} = lambda*[M]*{u} où lambda est -w^2/c^2
% On utilise la fonction matlab eigs avec smallestabs.

opts.tol  = 1e-10;
opts.maxit = 500;
 
[V, D] = eigs(K, M, P, 'smallestabs', opts);

lambda = diag(D); % Extraction des eigenvalues, soit les valeurs propres

[lambda, idx] = sort(lambda);  % Tri croissant
V = V(:, idx);  % Tri des vecteurs propres

%% Étape B v.

% Lambda = -w^2/c^2. Donc, w = sqrt(-lambda*c^2) et f_nat = w/2pi

w_propres = sqrt(-lambda.*c.^2); % Fréquences angulaires propres [rad/s]
w_propres = sort(w_propres);
f_propres = w_propres./(2*pi); % Fréquences propres [Hz]


%% Validation avec l'approche analytique
% Solution analytique
f_ana  = zeros(P,P);

for m = 1:P
    for n = 1:P
        f_ana(m,n) = c/(2*L) * sqrt(m^2 + n^2);
    end
end 
% Trier pour savoir les P premières fréquences
f_ana_ligne = f_ana(:);
f_ana_croissant = sort(f_ana_ligne);
f_ana_P = f_ana_croissant(1:P);

% Affichage des fréquences
fprintf('Validation : Affichage des %d premières fréquences propres\n',P);
fprintf('avec l''approche analytique de L''Annexe :\n ');
for i = 1:P
fprintf('Mode %-8d %-16.2f [Hz]\n ',i,f_ana_P(i));
end
%% Étape B vi.

% Pseudo-déclaration de l'aray x et y utiliser pour afficher les données (
% utiliser ensuite pour ajouter les bords x= 0 et x= l). Ces deux arrays
% sont utiliser pour établir la dimension du meshgrid. 
x_int = (1:N) * h; 
y_int = (1:N) * h;  

% Création du grid avec les bords de la plaque pour afficher nos vecteurs
% propres. Les donnés intérieurs du grid seront remplacé par les données
% des vecteurs propres. 
x_full = [0, x_int, L];
y_full = [0, y_int, L];
[Xf, Yf] = meshgrid(x_full, y_full);

% Détermination du nombre de figure à afficher. 
nrows = ceil(P/3);
ncols = min(P, 3);

figure('Name', 'Étape B vi — Déformées propres (MDF)', ...
       'NumberTitle', 'off', 'Position', [50, 50, 1000, 600]);

for p = 1:P
    % Extraction du vecteur propre p et on le remet dans la forme 2D(il
    % était dans la forme 1D comme array)
    mode_vec = V(:,p);                      
    mode_mat = reshape(mode_vec, [N, N]);   

    % Normalisation des données pour comparer les amplitudes de u entre
    % différentes fréquences. 
    mode_mat = mode_mat / max(abs(mode_mat(:)));

    % Création de la matrice U utiliser pour afficher les données, ajout
    % des bords u = 0 et ajout des données du vecteur propre dans les
    % données intérieurs de U. 
    U_full = zeros(N+2, N+2);
    U_full(2:end-1, 2:end-1) = mode_mat;

    % Affichage 3D des données
    subplot(nrows, ncols, p);
    surf(Xf, Yf, U_full, 'EdgeColor', 'none');
    colormap('jet');
    colorbar;
    xlabel('x [m]');
    ylabel('y [m]');
    zlabel('u [normalisé]');
    title(sprintf('Mode %d — f = %.1f Hz', (P+1)-p, f_propres(p)));
    view([-35, 30]);
    axis tight;
    shading interp;
end

sgtitle('Déformées propres de la membrane (différences finies)');


%% Étape B vii

tol_neg = -0.12;
tol_pos =  0.12;

figure('Name', 'Étape B vii — Figures de Chladni (MDF)', ...
       'NumberTitle', 'off', 'Position', [50, 700, 1000, 600]);

for p = 1:P

    mode_vec = V(:, p);
    mode_mat = reshape(mode_vec, [N, N]);
    mode_mat = mode_mat / max(abs(mode_mat(:)));

    U_full = zeros(N+2, N+2);
    U_full(2:end-1, 2:end-1) = mode_mat;


    masque = (U_full > tol_neg) & (U_full < tol_pos);

    % Garder seulement les cellules du masque qui sont bordées
    % Remplacement de imerode par une opération logique de voisinage
    % On regarde si un pixel est dans le masque ET si un de ses voisins ne l'est pas
    masque_voisins = masque(2:end-1, 2:end-1) & (...
                     ~masque(1:end-2, 2:end-1) | ~masque(3:end, 2:end-1) | ...
                     ~masque(2:end-1, 1:end-2) | ~masque(2:end-1, 3:end));
    
    % On remet aux bonnes dimensions (N+2 x N+2)
    masque_erode = zeros(size(masque));
    masque_erode(2:end-1, 2:end-1) = masque_voisins;

    subplot(nrows, ncols, p);

    imagesc(x_full, y_full, masque_erode);
    colormap(gca, [1 1 1; 0 0 0]);
    set(gca, 'YDir', 'normal');
    axis equal tight;
    hold on;

    plot([0 L L 0 0], [0 0 L L 0], 'k-', 'LineWidth', 2);

    xlabel('x [m]');
    ylabel('y [m]');
    title(sprintf('Mode %d — f = %.1f Hz', (P+1)-p, f_propres(p)));
    hold off;
end

sgtitle(sprintf('Figures de Chladni — contours [%.2f, %.2f]', tol_neg, tol_pos));










